# ─────────────────────────────────────────────────────────────────────────────
# NitroClip environment. Copy to .env and fill in as you obtain keys.
# The app runs with any subset: /health (and the UI banner) tells you exactly
# what each missing key blocks.
# ─────────────────────────────────────────────────────────────────────────────

# ══ Required to PLAN ads (ingest a store, generate + approve scripts) ════════

# Claude — script generation, brand voice, format extraction, captions.
# Get one at https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# Supabase — Postgres (with pgvector) + media storage. Create a free project at
# https://supabase.com, then:
#   SUPABASE_URL:              Project Settings → API → Project URL
#   SUPABASE_SERVICE_ROLE_KEY: Project Settings → API → service_role key
#   DATABASE_URL:              Project Settings → Database → Connection string
#                              (use the "Session pooler" URI, postgresql://...)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# OpenAI — Whisper transcription of reference videos, TTS voiceover, product
# embeddings. https://platform.openai.com → API keys
OPENAI_API_KEY=

# ══ Required to GENERATE media (images + video) ══════════════════════════════

# fal.ai — one key covers both Flux (images) and Veo 3.1 (video).
# https://fal.ai/dashboard/keys
FAL_KEY=

# ══ Optional ═════════════════════════════════════════════════════════════════

# Only needed for private/password-protected Shopify stores; public stores are
# read via the public /products.json endpoint with no key.
SHOPIFY_ADMIN_TOKEN=

# Model overrides (defaults shown; change only if you know why)
#CLAUDE_MODEL=claude-opus-4-8
#FAL_IMAGE_MODEL=fal-ai/flux/dev
#FAL_VIDEO_MODEL=fal-ai/veo3.1/fast/image-to-video
#OPENAI_TTS_MODEL=tts-1
#OPENAI_TTS_VOICE=alloy

# Frontend → backend URL (only needed if the backend isn't on localhost:8000)
#VITE_API_URL=http://localhost:8000

# Set to 0 to run the job worker as a separate process (python -m app.worker)
#RUN_WORKER=1
