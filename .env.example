# ─────────────────────────────────────────────────────────────────────────────
# NitroClip environment. Copy to .env and fill in as you obtain keys.
# The app runs with any subset: /health (and the UI banner) tells you exactly
# what each missing key blocks.
#
# Cheapest testing setup = ANTHROPIC + Supabase + FAL_KEY + OPENROUTER_API_KEY
# (OpenAI is optional — only Whisper transcription uses it by default, and even
# that can run locally; see "LOCAL MODELS" below.)
# ─────────────────────────────────────────────────────────────────────────────

# ══ Required to PLAN ads (ingest a store, generate + approve scripts) ════════

# Claude — script generation, brand voice, format extraction, captions.
# Get one at https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# Supabase — Postgres (with pgvector) + media storage. Create a free project at
# https://supabase.com, then:
#   SUPABASE_URL:              Project Settings → API → Project URL
#   SUPABASE_SERVICE_ROLE_KEY: Project Settings → API → service_role key
#   DATABASE_URL:              Project Settings → Database → Connection string
#                              (use the "Session pooler" URI, postgresql://...)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# OpenRouter — product embeddings via NVIDIA's FREE model ($0/M tokens).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ══ Required to GENERATE media (images + video + voiceover) ══════════════════

# fal.ai — one key covers Flux (images), Veo 3.1 (video) AND Kokoro voiceover
# (~$0.02 per 1k characters). https://fal.ai/dashboard/keys
FAL_KEY=

# ══ Optional ═════════════════════════════════════════════════════════════════

# OpenAI — only used for Whisper transcription of reference videos by default
# (~$0.006/min). Skip it and transcripts are omitted (format extraction still
# works from frames), or run Whisper locally (see LOCAL MODELS).
OPENAI_API_KEY=

# Only needed for private/password-protected Shopify stores; public stores are
# read via the public /products.json endpoint with no key.
SHOPIFY_ADMIN_TOKEN=

# ══ LOCAL MODELS (e.g. Apple Silicon Mac) — $0 inference while testing ═══════

# Voiceover locally with Kokoro 82M (in-process; model auto-downloads ~330MB):
#   backend/.venv/bin/pip install -r backend/requirements-local.txt
#TTS_PROVIDER=local            # default: fal (Kokoro hosted on fal.ai)
#TTS_VOICE=af_heart            # 19 voices: af_heart, af_bella, am_adam, ...
#KOKORO_MODEL_DIR=~/.cache/nitroclip/kokoro

# Or point TTS at any OpenAI-compatible /v1/audio/speech server
# (e.g. Kokoro-FastAPI on your Mac, or DeepInfra):
#TTS_PROVIDER=openai_compatible
#TTS_BASE_URL=http://localhost:8880/v1
#TTS_MODEL=kokoro

# Embeddings locally via Ollama (`ollama pull nomic-embed-text`):
#EMBEDDINGS_BASE_URL=http://localhost:11434/v1
#EMBEDDINGS_MODEL=nomic-embed-text
# (re-ingest brands after switching embedding models — vectors aren't comparable
#  across models; retrieval falls back to recency until you do)

# Whisper locally via any OpenAI-compatible server (speaches, LM Studio, ...):
#STT_BASE_URL=http://localhost:8000/v1
#STT_MODEL=Systran/faster-whisper-small

# ══ Tuning (defaults shown) ══════════════════════════════════════════════════

#CLAUDE_MODEL=claude-opus-4-8
#FAL_IMAGE_MODEL=fal-ai/flux/dev
#FAL_VIDEO_MODEL=fal-ai/veo3.1/fast/image-to-video
#FAL_TTS_MODEL=fal-ai/kokoro/american-english
#EMBEDDINGS_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# Frontend → backend URL (only needed if the backend isn't on localhost:8000)
#VITE_API_URL=http://localhost:8000

# Set to 0 to run the job worker as a separate process (python -m app.worker)
#RUN_WORKER=1
